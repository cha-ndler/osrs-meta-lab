  "_reasons": {
    "_comment": "Why an activity above has no targets. 'no-dps-answer' and 'absent-upstream' are different facts and are worth keeping apart: the first is settled, the second changes when the calculator's data does.",

    "Chest (Rogues' Castle)": "no-dps-answer: a loot container, not a fight",
    "Ecumenical key": "no-dps-answer: an item, not a fight",
    "Fishing Trawler": "no-dps-answer: skilling minigame",
    "Gout tuber": "no-dps-answer: a farming item",
    "Guardians of the Rift": "no-dps-answer: skilling minigame",
    "Hallowed Sepulchre": "no-dps-answer: an agility course; nothing is killed",
    "Hunters' Rumours": "no-dps-answer: a hunter task list",
    "Krystilia": "no-dps-answer: a slayer master, not a target",
    "Rocky": "no-dps-answer: a skilling pet",
    "Sulliuscep": "no-dps-answer: a woodcutting resource",
    "Tempoross": "no-dps-answer: a fishing encounter scored on damage-to-boat, not DPS",
    "Treasure Trails": "no-dps-answer: clue scrolls; the combat is incidental",
    "Vale Totems": "no-dps-answer: a woodcutting minigame",
    "Wintertodt": "no-dps-answer: a firemaking encounter; hits are not weapon attacks",

    "Hespori (Echo)": "absent-upstream: the Echo variant has its own stats and the calculator carries only the standard Hespori. Mapping it to that one would report a fight nobody had.",
    "Nightmare Zone": "absent-upstream: a configurable roster of ~30 boss variants rather than one encounter. Solvable once the mapping says which bosses a given dream contains."
  }
}
